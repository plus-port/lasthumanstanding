---
// Page shell shared by every screen: header navigation and base styles.
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/employees', label: 'Employees' },
  { href: '/roles', label: 'Roles' },
  { href: '/qualifications', label: 'Qualifications' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Northstar</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/employees">
        Northstar
      </a>
      <nav>
        {links.map((link) => (
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1f2933;
    --muted: #616e7c;
    --line: #d9e2ec;
    --paper: #f5f7fa;
    --ready: #147d64;
    --gap: #ba2525;
    font-family: system-ui, sans-serif;
    color: var(--ink);
  }
  body {
    margin: 0;
    background: var(--paper);
  }
  header {
    background: white;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
  }
  nav a {
    margin-right: 1rem;
    color: var(--muted);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  h1 {
    margin-top: 0.5rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    background: white;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  th,
  td {
    text-align: left;
    border-bottom: 1px solid var(--line);
    padding: 0.4rem 0.5rem;
  }
  tr:last-child td {
    border-bottom: 0;
  }
  form.inline {
    display: grid;
    gap: 0.5rem;
    max-width: 420px;
    margin-top: 1rem;
  }
  form.inline h2 {
    margin: 0;
    font-size: 1.1rem;
  }
  form.filter {
    max-width: 320px;
    margin-bottom: 1rem;
  }
  label {
    display: grid;
    gap: 0.2rem;
    font-size: 0.9rem;
  }
  label.check {
    grid-template-columns: auto 1fr;
    align-items: center;
  }
  input,
  select,
  button {
    font: inherit;
    padding: 0.35rem;
  }
  button {
    padding: 0.4rem 0.8rem;
  }
  fieldset {
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .notice {
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    background: white;
    border: 1px solid var(--line);
  }
  .notice.error {
    color: var(--gap);
    background: #fff1f1;
  }
  .compact {
    display: inline;
  }
</style>
